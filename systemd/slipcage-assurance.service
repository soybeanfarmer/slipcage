[Unit]
Description=Slipcage bounded non-destructive weekly local backup restore assurance
After=local-fs.target
ConditionPathIsDirectory=/var/backups/slipcage

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/lib/slipcage/assurance.py
TimeoutStartSec=10min
UMask=0077
StateDirectory=slipcage-assurance
StateDirectoryMode=0700
CacheDirectory=slipcage-assurance
CacheDirectoryMode=0700
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
ReadOnlyPaths=/var/backups/slipcage
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
MemoryAccounting=yes
MemoryMax=512M
CPUAccounting=yes
CPUQuota=35%
TasksMax=32
LimitNOFILE=128
LimitFSIZE=768M
KillMode=control-group
StandardOutput=journal
StandardError=journal
