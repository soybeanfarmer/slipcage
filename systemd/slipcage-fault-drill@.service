[Unit]
Description=Manual Slipcage guest-free controlled failure drill (%i)
After=local-fs.target

[Service]
Type=oneshot
User=slipcage-vmprobe
Group=slipcage-vmprobe
ExecStart=/usr/bin/python3 /usr/local/lib/slipcage/fault-drill.py --mode %i
TimeoutStartSec=40s
UMask=0077
StateDirectory=slipcage-fault
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
MemoryAccounting=yes
MemoryMax=128M
CPUAccounting=yes
CPUQuota=25%
TasksMax=32
LimitNOFILE=128
LimitFSIZE=1M
KillMode=control-group
